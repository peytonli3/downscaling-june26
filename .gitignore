# Large binaries & regenerable artifacts — managed outside git.
# NOTE: gitignore has no inline comments; keep patterns on their own lines.

# Raw + derived data (keep the manifest, ignore the binaries)
data/*
!data/README.md

# Checkpoints
*.pth

# Numpy arrays
*.npy
*.npz

# Optuna studies
*.db

# Figures (regenerable from scripts)
*.png

# Python caches
__pycache__/
*.pyc

# On-disk archive of dead artifacts (recoverable code is in git tags)
_archive/
