# Large binaries & regenerable artifacts — managed outside git.
# NOTE: gitignore has no inline comments; keep patterns on their own lines.

# Raw + derived data (keep the manifest, ignore the binaries)
data/*
!data/README.md

# Per-run outputs. Small text (*.log, *.csv, config.json) is tracked as cheap
# history; the heavy regenerable artifacts are not.
runs/*/checkpoints/
runs/*/figures/*
!runs/*/figures/*.csv
runs/*/presentation/*.pptx

# Python caches
__pycache__/
*.pyc

# Optuna studies
*.db

# Scratch
*.swp
.DS_Store

# Figures belong under runs/<version>/figures/ (ignored above). Anything under
# docs/ is a deliberately committed illustration, so it is NOT ignored here.
